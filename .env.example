# Never commit real values. local.env is supported only for local development.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Optional: only required if using an un-scoped personal key (sk-ant-usr-...)
ANTHROPIC_WORKSPACE_ID=

GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Frame.io V4 (Adobe OAuth access token; server-only)
FRAMEIO_ACCESS_TOKEN=
FRAMEIO_ACCOUNT_ID=
FRAMEIO_WORKSPACE_ID=
FRAMEIO_PROJECT_ID=
FRAMEIO_FOLDER_ID=
FRAMEIO_WEBHOOK_SECRET=

# Resend email adapter
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
DEMO_RECIPIENT_EMAIL=

# App/runtime
DATABASE_PATH=.data/dose-engine.db
PUBLIC_BASE_URL=http://localhost:3000
